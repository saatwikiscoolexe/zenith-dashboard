{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://uk1.airanode.cloud:25658/api/:path*"
    },
    {
      "source": "/transcripts/:path*",
      "destination": "http://uk1.airanode.cloud:25658/transcripts/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
